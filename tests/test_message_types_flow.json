    {
      "id": "summary",
      "type": "MESSAGE",
      "message": "¡Listo! He enviado todos los tipos de mensajes nativos de WhatsApp que funcionan:\n\n✅ Text (texto simple)\n✅ Interactive Buttons (botones de respuesta)\n✅ Interactive List (lista interactiva)\n✅ Image (imagen real)\n✅ Document (documento real)\n✅ Audio (audio real)\n✅ Video (video real)\n✅ Location (ubicación real)\n✅ Contacts (contacto real)\n✅ Reaction (reacción a mensaje)\n✅ Catalog (mensaje de catálogo)\n⚠️ Sticker (temporalmente desactivado)\n⚠️ Template (requiere aprobación de Meta)\n\n¿Recibiste todos correctamente?",
      "next_step": "end"
