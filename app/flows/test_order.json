{
  "id": "test_order",
  "name": "Test Order Flow",
  "description": "Test order flow for testing complex scenarios",
  "start_step": "welcome",
  "variables": {
    "company_name": "Test Store",
    "currency": "USD",
    "tax_rate": "0.10"
  },
  "error_handling": {
    "validation_failed": "show_error",
    "timeout": "show_timeout",
    "invalid_input": "ask_again"
  },
  "steps": [
    {
      "id": "welcome",
      "type": "message",
      "name": "Welcome Message",
      "message": "Bienvenido a {{company_name}}! Como puedo ayudarte hoy?",
      "next_step": "ask_intent"
    },
    {
      "id": "ask_intent",
      "type": "choice",
      "name": "Ask Intent",
      "message": "Que te gustaria hacer?",
      "options": [
        {
          "id": "order",
          "title": "Hacer pedido",
          "description": "Realizar un nuevo pedido"
        },
        {
          "id": "info",
          "title": "Informacion",
          "description": "Obtener informacion sobre productos"
        },
        {
          "id": "support",
          "title": "Soporte",
          "description": "Contactar soporte tecnico"
        }
      ],
      "next_step": "process_intent"
    },
    {
      "id": "process_intent",
      "type": "condition",
      "name": "Process Intent",
      "conditions": [
        {
          "condition": "user_choice == 'order'",
          "next_step": "ask_product"
        },
        {
          "condition": "user_choice == 'info'",
          "next_step": "show_info"
        },
        {
          "condition": "user_choice == 'support'",
          "next_step": "connect_support"
        }
      ]
    },
    {
      "id": "ask_product",
      "type": "question",
      "name": "Ask Product",
      "question": "Que producto te interesa?",
      "validation": {
        "required": true,
        "min_length": 3
      },
      "next_step": "ask_quantity"
    },
    {
      "id": "ask_quantity",
      "type": "question",
      "name": "Ask Quantity",
      "question": "Cuantas unidades necesitas?",
      "validation": {
        "required": true,
        "type": "number",
        "min": 1
      },
      "next_step": "calculate_total"
    },
    {
      "id": "calculate_total",
      "type": "message",
      "name": "Calculate Total",
      "message": "Perfecto! He calculado tu pedido. El total es {{total_amount}} {{currency}} (incluye {{tax_rate}}% de impuestos).",
      "next_step": "confirm_order"
    },
    {
      "id": "confirm_order",
      "type": "choice",
      "name": "Confirm Order",
      "message": "Deseas confirmar este pedido?",
      "options": [
        {
          "id": "yes",
          "title": "Si, confirmar"
        },
        {
          "id": "no",
          "title": "No, cancelar"
        }
      ],
      "next_step": "process_confirmation"
    },
    {
      "id": "process_confirmation",
      "type": "condition",
      "name": "Process Confirmation",
      "conditions": [
        {
          "condition": "confirmation == 'yes'",
          "next_step": "order_confirmed"
        },
        {
          "condition": "confirmation == 'no'",
          "next_step": "order_cancelled"
        }
      ]
    },
    {
      "id": "order_confirmed",
      "type": "message",
      "name": "Order Confirmed",
      "message": "Excelente! Tu pedido ha sido confirmado. Te enviaremos un email con los detalles.",
      "next_step": "end"
    },
    {
      "id": "order_cancelled",
      "type": "message",
      "name": "Order Cancelled",
      "message": "Entendido. Tu pedido ha sido cancelado. Hay algo mas en lo que pueda ayudarte?",
      "next_step": "ask_intent"
    },
    {
      "id": "show_info",
      "type": "message",
      "name": "Show Info",
      "message": "Tenemos una amplia variedad de productos disponibles. Puedes visitar nuestro catalogo en linea o preguntarme sobre productos especificos.",
      "next_step": "ask_intent"
    },
    {
      "id": "connect_support",
      "type": "message",
      "name": "Connect Support",
      "message": "Te conectare con nuestro equipo de soporte. Un agente se comunicara contigo pronto.",
      "next_step": "end"
    },
    {
      "id": "show_error",
      "type": "message",
      "name": "Show Error",
      "message": "Lo siento, hubo un error. Por favor, intenta nuevamente.",
      "next_step": "ask_intent"
    },
    {
      "id": "show_timeout",
      "type": "message",
      "name": "Show Timeout",
      "message": "La conversacion ha expirado. Te gustaria empezar de nuevo?",
      "next_step": "welcome"
    },
    {
      "id": "ask_again",
      "type": "message",
      "name": "Ask Again",
      "message": "Por favor, proporciona una respuesta valida.",
      "next_step": "ask_intent"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "message": "Gracias por contactarnos! Que tengas un excelente dia."
    }
  ],
  "metadata": {
    "version": "1.0",
    "author": "Test Creator",
    "last_updated": "2024-10-10",
    "tags": ["test", "order", "complex"],
    "complexity": "medium"
  }
}
