{
  "id": "test_main",
  "name": "Test Main Flow",
  "description": "Test flow without emojis for Windows console testing",
  "start_step": "check_user_status",
  "variables": {
    "company_name": "Test Company",
    "support_hours": "9:00 - 18:00"
  },
  "error_handling": {
    "validation_failed": "show_error",
    "timeout": "show_timeout"
  },
  "steps": [
    {
      "id": "check_user_status",
      "type": "condition",
      "name": "Check User Status",
      "conditions": [
        {
          "condition": "is_first_message == true",
          "next_step": "first_time_greeting"
        },
        {
          "condition": "is_first_message == false",
          "next_step": "returning_user_greeting"
        }
      ]
    },
    {
      "id": "first_time_greeting",
      "type": "message",
      "name": "First Time Greeting",
      "message": "Hola! Bienvenido a {{company_name}}. Soy tu asistente virtual y estoy aqui para ayudarte. En que puedo asistirte hoy?",
      "next_step": "wait_for_response"
    },
    {
      "id": "returning_user_greeting",
      "type": "message",
      "name": "Returning User Greeting",
      "message": "Hola de nuevo! Me alegra verte otra vez. En que mas puedo ayudarte hoy?",
      "next_step": "wait_for_response"
    },
    {
      "id": "wait_for_response",
      "type": "question",
      "name": "Wait for Response",
      "question": "Escribe tu consulta o pregunta:",
      "validation": {
        "required": true,
        "min_length": 2,
        "error_message": "Por favor, escribe tu consulta."
      },
      "next_step": "process_response"
    },
    {
      "id": "process_response",
      "type": "message",
      "name": "Process Response",
      "message": "Gracias por tu mensaje. He recibido tu consulta y la procesare pronto. Hay algo mas en lo que pueda ayudarte?",
      "next_step": "end"
    },
    {
      "id": "show_error",
      "type": "message",
      "name": "Show Error",
      "message": "Lo siento, hubo un error. Por favor, intenta nuevamente.",
      "next_step": "wait_for_response"
    },
    {
      "id": "show_timeout",
      "type": "message",
      "name": "Show Timeout",
      "message": "La conversacion ha expirado. Te gustaria empezar de nuevo?",
      "next_step": "check_user_status"
    },
    {
      "id": "end",
      "type": "end",
      "name": "End",
      "message": "Gracias por contactarnos!"
    }
  ],
  "metadata": {
    "version": "1.0",
    "author": "Test Creator",
    "last_updated": "2024-10-10",
    "tags": ["test", "simple", "greeting"],
    "complexity": "low"
  }
}
