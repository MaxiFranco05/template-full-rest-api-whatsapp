# Variables de entorno para Cafe API

# Base de datos
DATABASE_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/cafe_db
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/cafe_test_db
SQLITE_DATABASE_URL=sqlite:///./cafe_whatsapp.db

# Seguridad
SECRET_KEY=your-secret-key-change-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
ALLOWED_HOSTS=["*"]

# Redis (OPCIONAL - Solo necesario para cache y tareas asíncronas)
# REDIS_URL=redis://localhost:6379

# Celery (OPCIONAL - Solo necesario para tareas en background)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (opcional)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Cafe API

# Archivos estáticos
STATIC_FILES_PATH=app/static

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=token-WhatsApp
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token-demo-123
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# Sistema de mensajes
MESSAGES_FILE_PATH=app/data/messages.yaml
