# Variables de entorno para Business API Template

# Base de datos
DATABASE_TYPE=sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/business_db
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/business_test_db
SQLITE_DATABASE_URL=sqlite:///./business_api.db

# Seguridad
SECRET_KEY=your-secret-key-change-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS
ALLOWED_HOSTS=["*"]

# Redis (OPCIONAL - Solo necesario para cache y tareas asíncronas)
# REDIS_URL=redis://localhost:6379

# Celery (OPCIONAL - Solo necesario para tareas en background)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (opcional)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=Business API

# Archivos estáticos
STATIC_FILES_PATH=app/static

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=token-WhatsApp
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token-demo-123
WHATSAPP_API_URL=https://graph.facebook.com/v18.0

# WhatsApp System User (para acceso a catálogos)
WHATSAPP_USER_ID=tu_system_user_id
WHATSAPP_CATALOG_ID=tu_catalog_id

# Información de la empresa (personalizable)
COMPANY_NAME=Tu Empresa
COMPANY_PHONE=+1234567890
COMPANY_EMAIL=contacto@tuempresa.com
COMPANY_ADDRESS=123 Main Street, City, State
COMPANY_WEBSITE=www.tuempresa.com
COMPANY_DESCRIPTION=Descripción de tu empresa
